  <header>
    <div class="logo">Tshwaragano</div>
    <nav>
      <a href="#jobs">Find Jobs</a>
      <a href="#about">About Us</a>
    </nav>
  </header>

  <section class="hero">
    <h1>Your future starts here.</h1>
    <p>Connecting job seekers and employers across Botswana.</p>
    <div class="search">
      <input id="search" type="search"
        placeholder="Search jobs or locations">
      <button onclick="searchJobs()">Find Jobs</button>
    </div>
  </section>

  <main>
    <section id="jobs">
      <h2>Explore Opportunities</h2>
      <p class="muted">
        Discover example job categories and start planning your next step.
      </p>
      <div class="jobs" id="job-list">
        <article class="job" data-search="administration gaborone">
          <span class="tag">Example listing</span>
          <h3>Administrative Assistant</h3>
          <p class="muted">Location: Gaborone, Botswana</p>
          <p>Help a team stay organised and support daily office activities.</p>
          <button onclick="showDetails('Administrative Assistant')">
            View Details
          </button>
        </article>
        <article class="job" data-search="customer service francistown">
          <span class="tag">Example listing</span>
          <h3>Customer Service Assistant</h3>
          <p class="muted">Location: Francistown, Botswana</p>
          <p>Assist customers and help answer everyday questions.</p>
          <button onclick="showDetails('Customer Service Assistant')">
            View Details
          </button>
        </article>
        <article class="job" data-search="information technology maun">
          <span class="tag">Example listing</span>
          <h3>IT Support Assistant</h3>
          <p class="muted">Location: Maun, Botswana</p>
          <p>Help people solve basic computer and technology problems.</p>
          <button onclick="showDetails('IT Support Assistant')">
            View Details
          </button>
        </article>
      </div>
      <p id="message" role="status" class="muted"></p>
    </section>

    <section class="about" id="about">
      <h2>About Tshwaragano</h2>
      <p>
        Tshwaragano aims to bring job seekers and employers together in
        one place, making it easier to discover opportunities in Botswana.
      </p>
      <p><strong>Employers:</strong> Prepare to connect with local talent.</p>
      <p><strong>Job seekers:</strong> Explore opportunities and plan your future.</p>
    </section>
  </main>

  <footer>
    <strong>Tshwaragano</strong><br>
    Connecting people with opportunities in Botswana.<br>
    <small>Sample website — example jobs only, not verified vacancies.</small>
  </footer>

  <script>
    function searchJobs() {
      const query = document.getElementById('search').value
        .trim().toLowerCase();
      const jobs = document.querySelectorAll('.job');
      let count = 0;

      jobs.forEach(function(job) {
        const text = (job.innerText + ' ' + job.dataset.search)
          .toLowerCase();
        const matches = !query || text.includes(query);
        job.style.display = matches ? '' : 'none';
        if (matches) count++;
      });

      document.getElementById('message').textContent =
        count ? count + ' example listing(s) shown.' :
        'No matching example listings. Try another search.';
    }

    function showDetails(title) {
      alert(title + '\\n\\nThis is a sample listing. Applications are not yet enabled.');
    }
  </script>
